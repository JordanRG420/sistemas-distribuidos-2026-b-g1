# Literal values: no interpolation or shell evaluation. Optional outer quotes.
# Copy to env/dev.env; use scripts/mongo.mjs with --env-file explicitly.
COMPOSE_PROJECT_NAME=synkro-dev
MONGO_NETWORK=platform
MONGO_ADMIN_USER=<administrator-name>
MONGO_ADMIN_PASSWORD=<random-administrator-password>
SALES_APP_PASSWORD=<different-random-application-password>
# Generate 756 random bytes as base64; preserve this value for this volume.
MONGO_INTERNAL_KEY=<random-base64-replica-key>
MONGO_REPLICA_SET=rs0
MONGO_STARTUP_TIMEOUT_SECONDS=60
MONGO_CONNECT_TIMEOUT_MS=2000
